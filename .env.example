# Groq Whisper (free tier optimized untuk podcast panjang)
GROQ_API_KEY=your_groq_api_key
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_CHUNK_SECONDS=180
GROQ_RATE_LIMIT_PER_MINUTE=10
GROQ_MAX_RETRIES=5
GROQ_RETRY_BASE_DELAY=10
GROQ_MAX_FILE_MB=25

# Muse Spark (OpenAI-compatible) — contributor model otomatis fallback ke base untuk /chat/completions
# Meta AI: muse-spark-1.2-contributor (billing) -> code otomatis pakai muse-spark-1.2 untuk chat jika 404
# Cek via: curl $MUSE_BASE_URL/models -H "Authorization: Bearer $MUSE_API_KEY"
MUSE_API_KEY=your_muse_spark_key
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.2-contributor

# Coverr
COVERR_API_KEY=your_coverr_api_key
COVERR_BASE_URL=https://api.coverr.co

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# App
APP_HOST=0.0.0.0
APP_PORT=8000
STORAGE_DIR=storage
MUSIC_PATH=assets/trending.mp3

# Docker (opsional, override via env)
REDIS_PORT=6379

# yt-dlp
YTDLP_DOWNLOAD_DIR=storage/downloads
